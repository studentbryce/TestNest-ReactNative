{
  "name": "testneststudent",
  "license": "0BSD",
  "version": "1.0.1",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest tests/reactNativeTests.test.js tests/reactHooks.test.js",
    "test:all": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setupTests.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.(js|jsx|ts|tsx)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/*.test.{js,jsx}",
      "!src/index.js"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.0",
    "@expo-google-fonts/inter": "^0.4.1",
    "@expo-google-fonts/quicksand": "^0.4.0",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/drawer": "^7.5.6",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.24",
    "@supabase/supabase-js": "^2.58.0",
    "crypto-js": "^4.2.0",
    "expo": "~54.0.0",
    "expo-font": "~14.0.0",
    "expo-splash-screen": "^0.31.0",
    "expo-status-bar": "~2.3.0",
    "expo-updates": "~0.29.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.25.0",
    "react-native-reanimated": "~3.18.0",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "~4.12.0",
    "react-native-svg": "15.12.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^12.9.0",
    "babel-preset-expo": "~13.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "19.1.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "private": true
}
